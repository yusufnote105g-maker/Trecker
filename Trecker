name: Build APK
on: [push, workflow_dispatch]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v4
    
    - name: set up JDK 17
      uses: actions/setup-java@v4
      with:
        java-version: '17'
        distribution: 'zulu'
        
    - name: Unzip project
      run: unzip HabitTracker-project-2026-11-11-final-v2.zip
      
    - name: Grant execute permission for gradlew
      run: chmod +x habittracker/gradlew
      
    - name: Build with Gradle
      working-directory: ./habittracker
      run: ./gradlew assembleDebug
      
    - name: Upload APK
      uses: actions/upload-artifact@v4
      with:
        name: HabitTracker-APK
        path: habittracker/app/build/outputs/apk/debug/app-debug.apk
